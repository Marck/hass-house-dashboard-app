{
  "name": "hass-house-dashboard-app",
  "version": "0.3.0",
  "private": true,
  "description": "Custom Home Assistant dashboard: a zero-dependency frontend and a small Node backend.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint:js": "eslint --max-warnings 0 .",
    "lint:css": "stylelint --max-warnings 0 \"app/frontend/css/**/*.css\"",
    "start": "node app/backend/main.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/backend/*.test.js\"",
    "privacy": "node scripts/privacy-check.mjs",
    "verify": "npm run lint:js && npm run lint:css && npm test && npm run privacy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-compat": "7.0.2",
    "globals": "17.14.0",
    "stylelint": "18.0.0",
    "stylelint-config-recommended": "19.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.2"
  },
  "dependencies": {
    "oauth4webapi": "3.8.8"
  }
}
